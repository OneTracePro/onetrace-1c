// Чтение чеков ККМ и магазинов типовой конфигурации (Розница 2.3+, УНФ 1.6/3.0, УТ 11) для отправки в OneTrace.
// Имена реквизитов в конфигурациях различаются, поэтому текст запроса собирается по метаданным: для каждого поля —
// список возможных имён, берётся первое существующее. Имена — из метаданных, значения — параметрами запроса.

#Область ПрограммныйИнтерфейс

// Проведённые чеки после ДатаС до ДатаПо включительно, по возрастанию даты, не больше Лимит.
//
// Параметры:
//   ДатаС, ДатаПо - Дата;
//   Лимит - Число;
//   ПолеТовара - Строка - реквизит номенклатуры с id товара в каталоге OneTrace: Артикул, Код или Ссылка.
//
// Возвращаемое значение:
//   Массив из Структура - чеки в формате ОТ_КлиентAPI (Ид, Дата, Номер, Магазин, Сумма, Телефон, Карта, Email, Товары).
//
Функция Чеки(ДатаС, ДатаПо, Лимит, ПолеТовара = "Артикул") Экспорт

	Схема = СхемаЧека();
	Запрос = Новый Запрос(ТекстЗапросаЧеков(Схема, Лимит));
	Запрос.УстановитьПараметр("ДатаС", ДатаС);
	Запрос.УстановитьПараметр("ДатаПо", ДатаПо);
	Выборка = Запрос.Выполнить().Выбрать();

	Чеки = Новый Массив;
	Ссылки = Новый Массив;
	Владельцы = Новый Массив;

	Пока Выборка.Следующий() Цикл
		Чек = Новый Структура("Ид, Дата, Номер, Магазин, Сумма, Телефон, Карта, Email, Товары, Владелец");
		Чек.Ид = Строка(Выборка.Ссылка.УникальныйИдентификатор());
		Чек.Дата = Выборка.Дата;
		Чек.Номер = СокрЛП(Выборка.Номер);
		Чек.Магазин = ИдМагазина(Выборка.Магазин);
		Чек.Сумма = Выборка.Сумма;
		Чек.Карта = ?(ЗначениеЗаполнено(Выборка.КодКарты), СокрЛП(Выборка.КодКарты), "");
		Чек.Телефон = "";
		Чек.Email = "";
		Чек.Товары = Новый Массив;
		Чек.Владелец = ?(ЗначениеЗаполнено(Выборка.Покупатель), Выборка.Покупатель, Выборка.ВладелецКарты);

		Чеки.Добавить(Чек);
		Ссылки.Добавить(Выборка.Ссылка);

		Если ЗначениеЗаполнено(Чек.Владелец) И Владельцы.Найти(Чек.Владелец) = Неопределено Тогда
			Владельцы.Добавить(Чек.Владелец);
		КонецЕсли;
	КонецЦикла;

	Если Чеки.Количество() = 0 Тогда
		Возврат Чеки;
	КонецЕсли;

	ДобавитьТовары(Схема, Чеки, Ссылки, ПолеТовара);
	ДобавитьКонтакты(Чеки, Владельцы);

	Для Каждого Чек Из Чеки Цикл
		Чек.Удалить("Владелец");
	КонецЦикла;

	Возврат Чеки;

КонецФункции

// Магазины (точки продаж) — элементы справочника из реквизита магазина чека: id (код или уникальный идентификатор,
// как в чеках), наименование и адрес из контактной информации.
//
// Возвращаемое значение:
//   Массив из Структура(Ид, Наименование, Город, Адрес).
//
Функция Магазины() Экспорт

	Схема = СхемаЧека();
	Магазины = Новый Массив;

	Если Схема.Магазин = Неопределено Тогда
		Возврат Магазины;
	КонецЕсли;

	Для Каждого Тип Из Метаданные.Документы.ЧекККМ.Реквизиты[Схема.Магазин].Тип.Типы() Цикл
		МетаданныеМагазина = Метаданные.НайтиПоТипу(Тип);

		Если МетаданныеМагазина = Неопределено Или Не Метаданные.Справочники.Содержит(МетаданныеМагазина) Тогда
			Продолжить;
		КонецЕсли;

		Запрос = Новый Запрос(СтрШаблон(
			"ВЫБРАТЬ Магазины.Ссылка КАК Ссылка, Магазины.Наименование КАК Наименование ИЗ Справочник.%1 КАК Магазины
			|ГДЕ НЕ Магазины.ПометкаУдаления%2", МетаданныеМагазина.Имя,
			?(МетаданныеМагазина.Иерархический И МетаданныеМагазина.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов, " И НЕ Магазины.ЭтоГруппа", "")));
		Выборка = Запрос.Выполнить().Выбрать();

		Пока Выборка.Следующий() Цикл
			Магазины.Добавить(Новый Структура("Ид, Наименование, Город, Адрес, Ссылка",
				ИдМагазина(Выборка.Ссылка), СокрЛП(Выборка.Наименование), "", "", Выборка.Ссылка));
		КонецЦикла;
	КонецЦикла;

	ДобавитьАдреса(Магазины);

	Для Каждого Магазин Из Магазины Цикл
		Магазин.Удалить("Ссылка");
	КонецЦикла;

	Возврат Магазины;

КонецФункции

// Имена реквизитов чека в этой конфигурации — для формы настроек и диагностики.
//
// Возвращаемое значение:
//   Структура - Магазин, Карта, КодКарты, ВладелецКарты, Покупатель, Товары (Строка или Неопределено).
//
Функция СхемаЧека() Экспорт

	Документ = Метаданные.Документы.Найти("ЧекККМ");

	Если Документ = Неопределено Тогда
		ВызватьИсключение "В конфигурации нет документа «Чек ККМ» (ЧекККМ): расширение OneTrace работает с Розницей, УНФ и УТ.";
	КонецЕсли;

	Схема = Новый Структура;
	Схема.Вставить("Магазин", ПервыйРеквизит(Документ, "Магазин, СтруктурнаяЕдиница, Склад"));
	Схема.Вставить("Карта", ПервыйРеквизит(Документ, "КартаЛояльности, ДисконтнаяКарта, ИнформационнаяКарта"));
	Схема.Вставить("КодКарты", Неопределено);
	Схема.Вставить("ВладелецКарты", Неопределено);
	Схема.Вставить("Покупатель", ПервыйРеквизит(Документ, "Партнер, Контрагент, Покупатель, Клиент"));
	Схема.Вставить("Товары", Неопределено);

	Для Каждого Имя Из СтрРазделить("Товары, Запасы", ", ", Ложь) Цикл
		Если Документ.ТабличныеЧасти.Найти(Имя) <> Неопределено Тогда
			Схема.Товары = Имя;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Схема.Карта <> Неопределено Тогда
		Карта = Метаданные.НайтиПоТипу(Документ.Реквизиты[Схема.Карта].Тип.Типы()[0]);

		Если Карта <> Неопределено Тогда
			Схема.КодКарты = ПервыйРеквизит(Карта, "Штрихкод, КодКарты, КодКартыШтрихкод, МагнитныйКод, КодКартыМагнитный");
			Схема.ВладелецКарты = ПервыйРеквизит(Карта, "Партнер, ВладелецКарты, Контрагент");

			Если Схема.КодКарты = Неопределено И Карта.ДлинаКода > 0 Тогда
				Схема.КодКарты = "Код";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат Схема;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстЗапросаЧеков(Схема, Лимит)

	Поля = Новый Массив;
	Поля.Добавить("Чек.Ссылка КАК Ссылка");
	Поля.Добавить("Чек.Дата КАК Дата");
	Поля.Добавить("Чек.Номер КАК Номер");
	Поля.Добавить(?(Метаданные.Документы.ЧекККМ.Реквизиты.Найти("СуммаДокумента") <> Неопределено, "Чек.СуммаДокумента", "0") + " КАК Сумма");
	Поля.Добавить(?(Схема.Магазин <> Неопределено, "Чек." + Схема.Магазин, "НЕОПРЕДЕЛЕНО") + " КАК Магазин");
	Поля.Добавить(?(Схема.КодКарты <> Неопределено, "Чек." + Схема.Карта + "." + Схема.КодКарты, "НЕОПРЕДЕЛЕНО") + " КАК КодКарты");
	Поля.Добавить(?(Схема.ВладелецКарты <> Неопределено, "Чек." + Схема.Карта + "." + Схема.ВладелецКарты, "НЕОПРЕДЕЛЕНО") + " КАК ВладелецКарты");
	Поля.Добавить(?(Схема.Покупатель <> Неопределено, "Чек." + Схема.Покупатель, "НЕОПРЕДЕЛЕНО") + " КАК Покупатель");

	Возврат "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + "
		|	" + СтрСоединить(Поля, ",
		|	") + "
		|ИЗ
		|	Документ.ЧекККМ КАК Чек
		|ГДЕ
		|	Чек.Проведен
		|	И Чек.Дата > &ДатаС
		|	И Чек.Дата <= &ДатаПо
		|УПОРЯДОЧИТЬ ПО
		|	Чек.Дата,
		|	Чек.Ссылка";

КонецФункции

Процедура ДобавитьТовары(Схема, Чеки, Ссылки, ПолеТовара)

	Если Схема.Товары = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТабличнаяЧасть = Метаданные.Документы.ЧекККМ.ТабличныеЧасти[Схема.Товары];
	ЕстьЦена = ТабличнаяЧасть.Реквизиты.Найти("Цена") <> Неопределено;
	Ид = ?(ПолеТовара = "Ссылка", "Товары.Номенклатура", "Товары.Номенклатура." + ПолеТовара);

	Запрос = Новый Запрос(СтрШаблон(
		"ВЫБРАТЬ
		|	Товары.Ссылка КАК Ссылка,
		|	%1 КАК Ид,
		|	Товары.Количество КАК Количество,
		|	%2 КАК Цена
		|ИЗ
		|	Документ.ЧекККМ.%3 КАК Товары
		|ГДЕ
		|	Товары.Ссылка В (&Чеки)
		|УПОРЯДОЧИТЬ ПО
		|	Товары.НомерСтроки", Ид, ?(ЕстьЦена, "Товары.Цена", "0"), Схема.Товары));
	Запрос.УстановитьПараметр("Чеки", Ссылки);
	Выборка = Запрос.Выполнить().Выбрать();

	ПоСсылке = Новый Соответствие;
	Для Номер = 0 По Ссылки.ВГраница() Цикл
		ПоСсылке.Вставить(Ссылки[Номер], Чеки[Номер]);
	КонецЦикла;

	Пока Выборка.Следующий() Цикл
		Значение = ?(ПолеТовара = "Ссылка", Строка(Выборка.Ид.УникальныйИдентификатор()), СокрЛП(Выборка.Ид));

		Если ЗначениеЗаполнено(Значение) Тогда
			ПоСсылке[Выборка.Ссылка].Товары.Добавить(Новый Структура("Ид, Количество, Цена", Значение, Выборка.Количество, Выборка.Цена));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Телефон и email покупателя (владельца карты) — из табличной части «Контактная информация» его справочника
// (Партнеры, Контрагенты …): по одному запросу на справочник.
//
Процедура ДобавитьКонтакты(Чеки, Владельцы)

	Контакты = КонтактнаяИнформация(Владельцы);

	Для Каждого Чек Из Чеки Цикл
		Если Не ЗначениеЗаполнено(Чек.Владелец) Тогда
			Продолжить;
		КонецЕсли;

		Контакт = Контакты.Получить(Чек.Владелец);

		Если Контакт <> Неопределено Тогда
			Чек.Телефон = Контакт.Телефон;
			Чек.Email = Контакт.Email;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьАдреса(Магазины)

	Ссылки = Новый Массив;
	Для Каждого Магазин Из Магазины Цикл
		Ссылки.Добавить(Магазин.Ссылка);
	КонецЦикла;

	Контакты = КонтактнаяИнформация(Ссылки);

	Для Каждого Магазин Из Магазины Цикл
		Контакт = Контакты.Получить(Магазин.Ссылка);

		Если Контакт <> Неопределено Тогда
			Магазин.Адрес = Контакт.Адрес;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Ссылка → Структура(Телефон, Email, Адрес): первое значение каждого типа из табличной части КонтактнаяИнформация.
//
Функция КонтактнаяИнформация(Ссылки)

	Результат = Новый Соответствие;
	ПоСправочникам = Новый Соответствие;

	Для Каждого Ссылка Из Ссылки Цикл
		Если Не ЗначениеЗаполнено(Ссылка) Тогда
			Продолжить;
		КонецЕсли;

		Справочник = Ссылка.Метаданные();

		Если Не Метаданные.Справочники.Содержит(Справочник) Или Справочник.ТабличныеЧасти.Найти("КонтактнаяИнформация") = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Список = ПоСправочникам.Получить(Справочник.Имя);

		Если Список = Неопределено Тогда
			Список = Новый Массив;
			ПоСправочникам.Вставить(Справочник.Имя, Список);
		КонецЕсли;

		Список.Добавить(Ссылка);
	КонецЦикла;

	Для Каждого Справочник Из ПоСправочникам Цикл
		Запрос = Новый Запрос(СтрШаблон(
			"ВЫБРАТЬ
			|	КИ.Ссылка КАК Ссылка,
			|	КИ.Тип КАК Тип,
			|	КИ.Представление КАК Представление
			|ИЗ
			|	Справочник.%1.КонтактнаяИнформация КАК КИ
			|ГДЕ
			|	КИ.Ссылка В (&Ссылки)
			|	И КИ.Тип В (&Типы)
			|УПОРЯДОЧИТЬ ПО
			|	КИ.НомерСтроки", Справочник.Ключ));
		Запрос.УстановитьПараметр("Ссылки", Справочник.Значение);
		Запрос.УстановитьПараметр("Типы", ТипыКонтактов());
		Выборка = Запрос.Выполнить().Выбрать();

		Пока Выборка.Следующий() Цикл
			Контакт = Результат.Получить(Выборка.Ссылка);

			Если Контакт = Неопределено Тогда
				Контакт = Новый Структура("Телефон, Email, Адрес", "", "", "");
				Результат.Вставить(Выборка.Ссылка, Контакт);
			КонецЕсли;

			Значение = СокрЛП(Выборка.Представление);
			ИмяТипа = XMLСтрока(Выборка.Тип);

			Если ИмяТипа = "Телефон" И Контакт.Телефон = "" Тогда
				Контакт.Телефон = Значение;
			ИначеЕсли ИмяТипа = "АдресЭлектроннойПочты" И Контакт.Email = "" Тогда
				Контакт.Email = Значение;
			ИначеЕсли ИмяТипа = "Адрес" И Контакт.Адрес = "" Тогда
				Контакт.Адрес = Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ТипыКонтактов()

	Типы = Новый Массив;
	Перечисление = Метаданные.Перечисления.Найти("ТипыКонтактнойИнформации");

	Если Перечисление = Неопределено Тогда
		Возврат Типы;
	КонецЕсли;

	Для Каждого Имя Из СтрРазделить("Телефон, АдресЭлектроннойПочты, Адрес", ", ", Ложь) Цикл
		Если Перечисление.ЗначенияПеречисления.Найти(Имя) <> Неопределено Тогда
			Типы.Добавить(Перечисления.ТипыКонтактнойИнформации[Имя]);
		КонецЕсли;
	КонецЦикла;

	Возврат Типы;

КонецФункции

// id точки в OneTrace: код элемента справочника, без кода — уникальный идентификатор. Тот же id — в чеках и магазинах.
//
Функция ИдМагазина(Магазин) Экспорт

	Если Не ЗначениеЗаполнено(Магазин) Тогда
		Возврат "";
	КонецЕсли;

	МетаданныеМагазина = Магазин.Метаданные();

	Если Метаданные.Справочники.Содержит(МетаданныеМагазина) И МетаданныеМагазина.ДлинаКода > 0 Тогда
		Код = СокрЛП(Магазин.Код);

		Если Код <> "" Тогда
			Возврат Код;
		КонецЕсли;
	КонецЕсли;

	Возврат Строка(Магазин.УникальныйИдентификатор());

КонецФункции

Функция ПервыйРеквизит(ОбъектМетаданных, Имена)

	Для Каждого Имя Из СтрРазделить(Имена, ", ", Ложь) Цикл
		Если ОбъектМетаданных.Реквизиты.Найти(Имя) <> Неопределено Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
