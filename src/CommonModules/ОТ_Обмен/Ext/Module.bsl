// Обмен с OneTrace.pro: регламентное задание «OneTrace: отправка чеков» (каждые 15 минут) и команды формы настроек.
// Чеки — проведённые ЧекККМ после отметки ОТ_ВыгруженоПо (по дате чека), не моложе 5 минут (чек могут перепровести),
// пачками по 1000; отметка сдвигается после каждой отправленной пачки. Магазины — раз в сутки.
// Модуль привилегированный: читает чеки и константы расширения независимо от прав пользователя задания.

#Область ПрограммныйИнтерфейс

// Регламентное задание ОТ_ОтправкаЧеков.
//
Процедура ОтправитьНовыеЧеки() Экспорт

	Настройки = Настройки();

	Если Не ЗначениеЗаполнено(Настройки.Адрес) Или Не ЗначениеЗаполнено(Настройки.Ключ) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОтправитьЧеки(Настройки);

		Если Константы.ОТ_МагазиныОтправлены.Получить() < НачалоДня(ТекущаяДатаСеанса()) Тогда
			ОтправитьМагазины(Настройки);
		КонецЕсли;

		Константы.ОТ_ПоследняяОшибка.Установить("");
	Исключение
		Текст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Константы.ОТ_ПоследняяОшибка.Установить(Формат(ТекущаяДатаСеанса(), "ДЛФ=DT") + ": " + Текст);
		ЗаписьЖурналаРегистрации(СобытиеЖурнала(), УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Настройки из констант расширения для ОТ_КлиентAPI.
//
// Возвращаемое значение:
//   Структура - см. ОТ_КлиентAPI.НовыеНастройки; дополнительно ПолеТовара.
//
Функция Настройки() Экспорт

	Настройки = ОТ_КлиентAPI.НовыеНастройки(Константы.ОТ_АдресСервера.Получить(), Константы.ОТ_СекретныйКлюч.Получить());
	Событие = СокрЛП(Константы.ОТ_СобытиеПокупки.Получить());

	Если Событие <> "" Тогда
		Настройки.Событие = Событие;
	КонецЕсли;

	ПолеТовара = СокрЛП(Константы.ОТ_ПолеТовара.Получить());
	Настройки.Вставить("ПолеТовара", ?(ПолеТовара = "", "Артикул", ПолеТовара));

	Возврат Настройки;

КонецФункции

// Значения настроек для формы.
//
// Возвращаемое значение:
//   Структура - Адрес, Ключ, Событие, ПолеТовара, ВыгружатьС.
//
Функция ЗначенияНастроек() Экспорт

	Возврат Новый Структура("Адрес, Ключ, Событие, ПолеТовара, ВыгружатьС",
		Константы.ОТ_АдресСервера.Получить(), Константы.ОТ_СекретныйКлюч.Получить(), Константы.ОТ_СобытиеПокупки.Получить(),
		Константы.ОТ_ПолеТовара.Получить(), Константы.ОТ_ВыгружатьС.Получить());

КонецФункции

// Сохраняет настройки формы и включает регламентное задание, когда указаны адрес и ключ. Смена даты «выгружать с»
// сбрасывает отметку отправленных чеков: чеки с новой даты уйдут заново (повтор чека платформа отбросит).
//
// Параметры:
//   Значения - Структура - см. ЗначенияНастроек.
//
Процедура СохранитьНастройки(Значения) Экспорт

	Если Значения.ВыгружатьС <> Константы.ОТ_ВыгружатьС.Получить() Тогда
		Константы.ОТ_ВыгруженоПо.Установить(Дата(1, 1, 1));
	КонецЕсли;

	Константы.ОТ_АдресСервера.Установить(СокрЛП(Значения.Адрес));
	Константы.ОТ_СекретныйКлюч.Установить(СокрЛП(Значения.Ключ));
	Константы.ОТ_СобытиеПокупки.Установить(СокрЛП(Значения.Событие));
	Константы.ОТ_ПолеТовара.Установить(СокрЛП(Значения.ПолеТовара));
	Константы.ОТ_ВыгружатьС.Установить(Значения.ВыгружатьС);

	Задание = РегламентныеЗадания.НайтиПредопределенное(Метаданные.РегламентныеЗадания.ОТ_ОтправкаЧеков);

	Если Задание <> Неопределено Тогда
		// Каждые 15 минут, весь день.
		Расписание = Новый РасписаниеРегламентногоЗадания;
		Расписание.ПериодПовтораДней = 1;
		Расписание.ПериодПовтораВТечениеДня = 900;
		Задание.Расписание = Расписание;
		Задание.Использование = ЗначениеЗаполнено(Значения.Адрес) И ЗначениеЗаполнено(Значения.Ключ);
		Задание.Записать();
	КонецЕсли;

КонецПроцедуры

// Состояние обмена для формы настроек.
//
// Возвращаемое значение:
//   Структура - ВыгруженоПо (Дата), МагазиныОтправлены (Дата), ПоследняяОшибка (Строка), Схема (Строка).
//
Функция Состояние() Экспорт

	Схема = ОТ_ЧекиКонфигурации.СхемаЧека();
	Описание = Новый Массив;

	Для Каждого Поле Из Схема Цикл
		Описание.Добавить(Поле.Ключ + ": " + ?(Поле.Значение = Неопределено, "—", Поле.Значение));
	КонецЦикла;

	Возврат Новый Структура("ВыгруженоПо, МагазиныОтправлены, ПоследняяОшибка, Схема",
		Константы.ОТ_ВыгруженоПо.Получить(), Константы.ОТ_МагазиныОтправлены.Получить(),
		Константы.ОТ_ПоследняяОшибка.Получить(), СтрСоединить(Описание, "; "));

КонецФункции

// Отправить сейчас (команда формы): чеки и магазины.
//
// Возвращаемое значение:
//   Строка - итог для пользователя.
//
Функция ОтправитьСейчас() Экспорт

	Настройки = Настройки();
	Итог = ОтправитьЧеки(Настройки);
	Магазинов = ОтправитьМагазины(Настройки);
	Константы.ОТ_ПоследняяОшибка.Установить("");

	Возврат СтрШаблон("Отправлено чеков: %1, пропущено: %2, магазинов: %3.", Итог.Отправлено, Итог.Пропущено, Магазинов);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пачки чеков после отметки; за один запуск — не больше 50 000 чеков (остальные — в следующий раз).
//
Функция ОтправитьЧеки(Настройки)

	Итог = Новый Структура("Отправлено, Пропущено", 0, 0);
	ВыгруженоПо = Константы.ОТ_ВыгруженоПо.Получить();

	Если Не ЗначениеЗаполнено(ВыгруженоПо) Тогда
		ВыгружатьС = Константы.ОТ_ВыгружатьС.Получить();
		ВыгруженоПо = ?(ЗначениеЗаполнено(ВыгружатьС), ВыгружатьС - 1, НачалоДня(ТекущаяДатаСеанса()) - 30 * 86400);
	КонецЕсли;

	ДатаПо = ТекущаяДатаСеанса() - 300;
	Размер = 1000;

	Пока Итог.Отправлено + Итог.Пропущено < 50000 Цикл
		Чеки = ОТ_ЧекиКонфигурации.Чеки(ВыгруженоПо, ДатаПо, Размер, Настройки.ПолеТовара);

		Если Чеки.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;

		// Полная пачка: чеки последней секунды могли не войти — они уйдут следующей пачкой (отметка — по дате).
		Последняя = Чеки[Чеки.ВГраница()].Дата;

		Если Чеки.Количество() = Размер И Чеки[0].Дата <> Последняя Тогда
			Пока Чеки[Чеки.ВГраница()].Дата = Последняя Цикл
				Чеки.Удалить(Чеки.ВГраница());
			КонецЦикла;

			Последняя = Чеки[Чеки.ВГраница()].Дата;
		КонецЕсли;

		Результат = ОТ_КлиентAPI.ОтправитьЧеки(Настройки, Чеки);
		Итог.Отправлено = Итог.Отправлено + Результат.Отправлено;
		Итог.Пропущено = Итог.Пропущено + Результат.Пропущено.Количество();
		ЗаписатьПропущенные(Результат.Пропущено);

		ВыгруженоПо = Последняя;
		Константы.ОТ_ВыгруженоПо.Установить(ВыгруженоПо);

		Если Чеки.Количество() < Размер Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Итог.Отправлено + Итог.Пропущено > 0 Тогда
		ЗаписьЖурналаРегистрации(СобытиеЖурнала(), УровеньЖурналаРегистрации.Информация, , ,
			СтрШаблон("Отправлено чеков: %1, пропущено: %2; отправлено по %3.", Итог.Отправлено, Итог.Пропущено, ВыгруженоПо));
	КонецЕсли;

	Возврат Итог;

КонецФункции

Функция ОтправитьМагазины(Настройки)

	Магазины = ОТ_ЧекиКонфигурации.Магазины();
	Отправлено = ?(Магазины.Количество() > 0, ОТ_КлиентAPI.ОтправитьМагазины(Настройки, Магазины), 0);
	Константы.ОТ_МагазиныОтправлены.Установить(ТекущаяДатаСеанса());

	Возврат Отправлено;

КонецФункции

Процедура ЗаписатьПропущенные(Пропущено)

	Если Пропущено.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Строки = Новый Массив;
	Для Каждого Пропуск Из Пропущено Цикл
		Строки.Добавить(Пропуск.Ид + ": " + Пропуск.Причина);

		Если Строки.Количество() = 20 Тогда
			Строки.Добавить(СтрШаблон("… и ещё %1", Пропущено.Количество() - 20));
			Прервать;
		КонецЕсли;
	КонецЦикла;

	ЗаписьЖурналаРегистрации(СобытиеЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
		"Чеки не отправлены (уникальный идентификатор документа: причина):" + Символы.ПС + СтрСоединить(Строки, Символы.ПС));

КонецПроцедуры

Функция СобытиеЖурнала()

	Возврат "OneTrace.Отправка чеков";

КонецФункции

#КонецОбласти
