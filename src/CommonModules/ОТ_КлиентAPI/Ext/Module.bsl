// Клиент API OneTrace.pro для расширения 1С: сообщения офлайн-чеков, отправка пакетами, справочник магазинов,
// проверка ключа. Модуль не обращается к метаданным конфигурации и константам — только к переданным данным, поэтому
// один и тот же код работает в 1С:Предприятии и в OneScript (тесты в tests/).
//
// Чек — Структура:
//   Ид       — Строка: уникальный идентификатор документа (повтор того же чека отбрасывается платформой);
//   Дата     — Дата: время чека в часовом поясе сеанса;
//   Номер    — Строка;
//   Магазин  — Строка: id точки (как в справочнике магазинов OneTrace);
//   Сумма    — Число;
//   Телефон, Карта, Email — Строка: покупатель (хотя бы одно);
//   Товары   — Массив из Структура(Ид, Количество, Цена).
//
// Настройки — результат НовыеНастройки().

#Область ПрограммныйИнтерфейс

// Настройки подключения и правила офлайн-покупки проекта.
//
// Параметры:
//   Адрес - Строка - адрес платформы, например https://cdp.onetrace.pro;
//   Ключ  - Строка - секретный ключ API проекта.
//
// Возвращаемое значение:
//   Структура - Адрес, Ключ, Событие, СвойствоКанала, ЗначениеКанала, СвойствоМагазина, СвойствоСуммы, Таймаут.
//
Функция НовыеНастройки(Адрес, Ключ) Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("Адрес", СокрЛП(Адрес));
	Настройки.Вставить("Ключ", СокрЛП(Ключ));
	Настройки.Вставить("Событие", "order_completed");
	Настройки.Вставить("СвойствоКанала", "channel");
	Настройки.Вставить("ЗначениеКанала", "offline");
	Настройки.Вставить("СвойствоМагазина", "store_id");
	Настройки.Вставить("СвойствоСуммы", "amount");
	Настройки.Вставить("Таймаут", 30);

	Возврат Настройки;

КонецФункции

// Сообщение track офлайн-чека для API (POST /api/v1/batch). Покупатель опознаётся по телефону, карте лояльности или
// email в context.traits — так платформа принимает события только с секретным ключом.
//
// Возвращаемое значение:
//   Соответствие - сообщение для ЗаписатьJSON.
//
Функция СообщениеЧека(Чек, Настройки) Экспорт

	Свойства = Новый Соответствие;
	Свойства.Вставить(Настройки.СвойствоКанала, Настройки.ЗначениеКанала);
	Свойства.Вставить(Настройки.СвойствоМагазина, Чек.Магазин);
	Свойства.Вставить(Настройки.СвойствоСуммы, Чек.Сумма);
	Свойства.Вставить("order_id", Чек.Номер);

	Товары = Новый Массив;
	Для Каждого Строка Из Чек.Товары Цикл
		Товар = Новый Соответствие;
		Товар.Вставить("product_id", Строка.Ид);
		Товар.Вставить("quantity", Строка.Количество);
		Товар.Вставить("price", Строка.Цена);
		Товары.Добавить(Товар);
	КонецЦикла;

	Если Товары.Количество() > 0 Тогда
		Свойства.Вставить("products", Товары);
	КонецЕсли;

	Покупатель = Новый Соответствие;
	ДобавитьНепустое(Покупатель, "phone", Чек.Телефон);
	ДобавитьНепустое(Покупатель, "loyalty_card", Чек.Карта);
	ДобавитьНепустое(Покупатель, "email", Чек.Email);

	Контекст = Новый Соответствие;
	Контекст.Вставить("traits", Покупатель);
	Контекст.Вставить("source", "1c");

	Сообщение = Новый Соответствие;
	Сообщение.Вставить("type", "track");
	Сообщение.Вставить("event", Настройки.Событие);
	Сообщение.Вставить("messageId", "1c-" + Чек.Ид);
	Сообщение.Вставить("timestamp", ВремяUTC(Чек.Дата));
	Сообщение.Вставить("properties", Свойства);
	Сообщение.Вставить("context", Контекст);

	Возврат Сообщение;

КонецФункции

// Чек можно отправить: есть покупатель (телефон, карта или email). Чек без покупателя не связать с онлайн-историей.
//
Функция ЕстьПокупатель(Чек) Экспорт

	Возврат ЗначениеЗаполнено(Чек.Телефон) Или ЗначениеЗаполнено(Чек.Карта) Или ЗначениеЗаполнено(Чек.Email);

КонецФункции

// Отправляет чеки пакетами по РазмерПакета(). Чек, который платформа отклонила (неверный телефон, нет покупателя),
// пропускается, остальные из его пакета отправляются ещё раз.
//
// Возвращаемое значение:
//   Структура - Отправлено (Число), Пропущено (Массив из Структура(Ид, Причина)).
//
// Исключения: платформа недоступна, ключ не подходит, превышен лимит — чеки нужно отправить позже.
//
Функция ОтправитьЧеки(Настройки, Чеки) Экспорт

	Итог = Новый Структура("Отправлено, Пропущено", 0, Новый Массив);
	Пакет = Новый Массив;

	Для Каждого Чек Из Чеки Цикл
		Если Не ЕстьПокупатель(Чек) Тогда
			Итог.Пропущено.Добавить(Новый Структура("Ид, Причина", Чек.Ид, "нет телефона, карты или email покупателя"));
			Продолжить;
		КонецЕсли;

		Пакет.Добавить(Чек);

		Если Пакет.Количество() = РазмерПакета() Тогда
			ОтправитьПакет(Настройки, Пакет, Итог);
			Пакет = Новый Массив;
		КонецЕсли;
	КонецЦикла;

	Если Пакет.Количество() > 0 Тогда
		ОтправитьПакет(Настройки, Пакет, Итог);
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Отправляет справочник магазинов (POST /api/v1/stores, до 1000 за запрос): id точки, название, город, адрес.
// Нужен ключ с правом products.write.
//
// Параметры:
//   Магазины - Массив из Структура(Ид, Наименование, Город, Адрес).
//
// Возвращаемое значение:
//   Число - отправлено магазинов.
//
Функция ОтправитьМагазины(Настройки, Магазины) Экспорт

	Отправлено = 0;
	Часть = Новый Массив;

	Для Каждого Магазин Из Магазины Цикл
		Элемент = Новый Соответствие;
		Элемент.Вставить("id", Лев(Магазин.Ид, 128));
		Элемент.Вставить("name", Лев(?(ЗначениеЗаполнено(Магазин.Наименование), Магазин.Наименование, Магазин.Ид), 200));
		ДобавитьНепустое(Элемент, "city", Лев(Магазин.Город, 120));
		ДобавитьНепустое(Элемент, "address", Лев(Магазин.Адрес, 300));
		Часть.Добавить(Элемент);

		Если Часть.Количество() = 1000 Тогда
			Отправлено = Отправлено + ОтправитьЧастьМагазинов(Настройки, Часть);
			Часть = Новый Массив;
		КонецЕсли;
	КонецЦикла;

	Если Часть.Количество() > 0 Тогда
		Отправлено = Отправлено + ОтправитьЧастьМагазинов(Настройки, Часть);
	КонецЕсли;

	Возврат Отправлено;

КонецФункции

// Проверяет адрес и ключ (GET /api/v1/key).
//
// Возвращаемое значение:
//   Структура - Успех (Булево), Текст (Строка): тип ключа или описание ошибки.
//
Функция ПроверитьПодключение(Настройки) Экспорт

	Попытка
		Ответ = ВызовAPI(Настройки, "GET", "/api/v1/key", "");
	Исключение
		Возврат Новый Структура("Успех, Текст", Ложь, ОписаниеОшибки());
	КонецПопытки;

	Если Ответ.КодСостояния = 200 Тогда
		Данные = ПрочитатьОтвет(Ответ.Тело);
		Тип = ?(ТипЗнч(Данные) = Тип("Соответствие"), Данные.Получить("type"), Неопределено);

		Если Тип <> "secret" Тогда
			Возврат Новый Структура("Успех, Текст", Ложь, "Нужен секретный ключ: чеки с телефоном и картой принимаются только с ним.");
		КонецЕсли;

		Возврат Новый Структура("Успех, Текст", Истина, "Подключение работает, ключ секретный.");
	КонецЕсли;

	Возврат Новый Структура("Успех, Текст", Ложь, ТекстОшибки(Ответ));

КонецФункции

// Чеков в одном запросе: тело — до 1 МБ, в пакете платформы — до 500 сообщений.
//
Функция РазмерПакета() Экспорт

	Возврат 100;

КонецФункции

// Время 1С (часовой пояс сеанса) → ISO 8601 в UTC.
//
Функция ВремяUTC(Дата) Экспорт

	Возврат XMLСтрока(УниверсальноеВремя(Дата)) + "Z";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОтправитьПакет(Настройки, Пакет, Итог)

	Сообщения = Новый Массив;
	Для Каждого Чек Из Пакет Цикл
		Сообщения.Добавить(СообщениеЧека(Чек, Настройки));
	КонецЦикла;

	Тело = Новый Соответствие;
	Тело.Вставить("batch", Сообщения);
	Ответ = ВызовAPI(Настройки, "POST", "/api/v1/batch", ВJSON(Тело));

	Если Ответ.КодСостояния = 202 Тогда
		Итог.Отправлено = Итог.Отправлено + Пакет.Количество();
		Возврат;
	КонецЕсли;

	// 422 — ошибки сообщений с номером: batch.<номер>.<поле>. Такие чеки пропускаются, остальные — ещё раз.
	Отклоненные = ?(Ответ.КодСостояния = 422, ОтклоненныеСообщения(Ответ.Тело), Новый Соответствие);

	Если Отклоненные.Количество() = 0 Тогда
		ВызватьИсключение ТекстОшибки(Ответ);
	КонецЕсли;

	Остальные = Новый Массив;
	Для Номер = 0 По Пакет.Количество() - 1 Цикл
		Причина = Отклоненные.Получить(Номер);

		Если Причина = Неопределено Тогда
			Остальные.Добавить(Пакет[Номер]);
		Иначе
			Итог.Пропущено.Добавить(Новый Структура("Ид, Причина", Пакет[Номер].Ид, Причина));
		КонецЕсли;
	КонецЦикла;

	Если Остальные.Количество() > 0 Тогда
		ОтправитьПакет(Настройки, Остальные, Итог);
	КонецЕсли;

КонецПроцедуры

Функция ОтправитьЧастьМагазинов(Настройки, Часть)

	Тело = Новый Соответствие;
	Тело.Вставить("items", Часть);
	Ответ = ВызовAPI(Настройки, "POST", "/api/v1/stores", ВJSON(Тело));

	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение ТекстОшибки(Ответ);
	КонецЕсли;

	Возврат Часть.Количество();

КонецФункции

// Номера отклонённых сообщений пакета и причина: из ошибок 422 вида {"errors": {"batch.3.anonymousId": ["…"]}}.
//
Функция ОтклоненныеСообщения(ТелоОтвета)

	Результат = Новый Соответствие;
	Данные = ПрочитатьОтвет(ТелоОтвета);

	Если ТипЗнч(Данные) <> Тип("Соответствие") Или ТипЗнч(Данные.Получить("errors")) <> Тип("Соответствие") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Ошибка Из Данные.Получить("errors") Цикл
		Части = СтрРазделить(Ошибка.Ключ, ".");

		Если Части.Количество() < 2 Или Части[0] <> "batch" Тогда
			Продолжить;
		КонецЕсли;

		Номер = ЧислоИзСтроки(Части[1]);

		Если Номер = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Без userId и anonymousId платформа опознаёт чек только по телефону, карте или email.
		Если Части.Количество() > 2 И (Части[2] = "anonymousId" Или Части[2] = "userId") Тогда
			Результат.Вставить(Номер, "платформа не опознала покупателя: проверьте телефон, карту или email");
			Продолжить;
		КонецЕсли;

		Тексты = Ошибка.Значение;
		Результат.Вставить(Номер, ?(ТипЗнч(Тексты) = Тип("Массив") И Тексты.Количество() > 0, Строка(Тексты[0]), Строка(Тексты)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// HTTP-запрос к платформе с секретным ключом. Возвращаемое значение — Структура(КодСостояния, Тело).
//
Функция ВызовAPI(Настройки, Метод, Путь, Тело)

	Адрес = Настройки.Адрес;
	Защищенное = СтрНачинаетсяС(НРег(Адрес), "https://");
	Хост = Сред(Адрес, ?(Защищенное, 9, ?(СтрНачинаетсяС(НРег(Адрес), "http://"), 8, 1)));
	Позиция = СтрНайти(Хост, "/");

	Если Позиция > 0 Тогда
		Хост = Лев(Хост, Позиция - 1);
	КонецЕсли;

	Порт = ?(Защищенное, 443, 80);
	Позиция = СтрНайти(Хост, ":");

	Если Позиция > 0 Тогда
		Порт = Число(Сред(Хост, Позиция + 1));
		Хост = Лев(Хост, Позиция - 1);
	КонецЕсли;

	Если Защищенное Тогда
		Соединение = Новый HTTPСоединение(Хост, Порт, , , , Настройки.Таймаут, Новый ЗащищенноеСоединениеOpenSSL);
	Иначе
		Соединение = Новый HTTPСоединение(Хост, Порт, , , , Настройки.Таймаут);
	КонецЕсли;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Настройки.Ключ);
	Заголовки.Вставить("Accept", "application/json");
	Заголовки.Вставить("Accept-Language", "ru");
	Заголовки.Вставить("User-Agent", "onetrace-1c/1.0.0");

	ЗапросHTTP = Новый HTTPЗапрос(Путь, Заголовки);

	Если Метод = "POST" Тогда
		ЗапросHTTP.Заголовки.Вставить("Content-Type", "application/json");
		// Тело — UTF-8 без BOM: с BOM платформа не разберёт JSON.
		ЗапросHTTP.УстановитьТелоИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзСтроки(Тело, "UTF-8"));
		Ответ = Соединение.ОтправитьДляОбработки(ЗапросHTTP);
	Иначе
		Ответ = Соединение.Получить(ЗапросHTTP);
	КонецЕсли;

	Возврат Новый Структура("КодСостояния, Тело", Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку("UTF-8"));

КонецФункции

Функция ТекстОшибки(Ответ)

	Данные = ПрочитатьОтвет(Ответ.Тело);
	Текст = ?(ТипЗнч(Данные) = Тип("Соответствие") И Данные.Получить("message") <> Неопределено, Строка(Данные.Получить("message")), Лев(Ответ.Тело, 500));

	Возврат СтрШаблон("OneTrace: HTTP %1: %2", Ответ.КодСостояния, Текст);

КонецФункции

Функция ВJSON(Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);

	Возврат Запись.Закрыть();

КонецФункции

Функция ПрочитатьОтвет(Текст)

	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);

	Попытка
		Данные = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Данные = Неопределено;
	КонецПопытки;

	Чтение.Закрыть();

	Возврат Данные;

КонецФункции

Процедура ДобавитьНепустое(Соответствие, Ключ, Значение)

	Если ЗначениеЗаполнено(Значение) Тогда
		Соответствие.Вставить(Ключ, СокрЛП(Значение));
	КонецЕсли;

КонецПроцедуры

Функция ЧислоИзСтроки(Текст)

	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Позиция, 1)) = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;

	Возврат Число(Текст);

КонецФункции

#КонецОбласти
