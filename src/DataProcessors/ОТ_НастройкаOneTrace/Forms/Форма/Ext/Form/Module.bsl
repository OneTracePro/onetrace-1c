// Настройка обмена с OneTrace.pro: адрес платформы, секретный ключ, событие покупки, поле товара, дата начала выгрузки;
// проверка подключения и отправка сейчас. Константы и регламентное задание меняет привилегированный модуль ОТ_Обмен.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Значения = ОТ_Обмен.ЗначенияНастроек();
	Адрес = Значения.Адрес;
	Ключ = Значения.Ключ;
	Событие = ?(ЗначениеЗаполнено(Значения.Событие), Значения.Событие, "order_completed");
	ПолеТовара = ?(ЗначениеЗаполнено(Значения.ПолеТовара), Значения.ПолеТовара, "Артикул");
	ВыгружатьС = Значения.ВыгружатьС;

	Элементы.ПолеТовара.СписокВыбора.Добавить("Артикул", "Артикул номенклатуры");
	Элементы.ПолеТовара.СписокВыбора.Добавить("Код", "Код номенклатуры");
	Элементы.ПолеТовара.СписокВыбора.Добавить("Ссылка", "Уникальный идентификатор номенклатуры");

	ОбновитьСостояние();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)

	СохранитьНаСервере();
	ПоказатьОповещениеПользователя("OneTrace", , "Настройки сохранены");

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодключение(Команда)

	ПоказатьПредупреждение(, ПроверитьПодключениеНаСервере(Адрес, Ключ));

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСейчас(Команда)

	ПоказатьПредупреждение(, ОтправитьСейчасНаСервере());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СохранитьНаСервере()

	ОТ_Обмен.СохранитьНастройки(Новый Структура("Адрес, Ключ, Событие, ПолеТовара, ВыгружатьС", Адрес, Ключ, Событие, ПолеТовара, ВыгружатьС));
	ОбновитьСостояние();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьПодключениеНаСервере(Адрес, Ключ)

	Возврат ОТ_КлиентAPI.ПроверитьПодключение(ОТ_КлиентAPI.НовыеНастройки(Адрес, Ключ)).Текст;

КонецФункции

&НаСервере
Функция ОтправитьСейчасНаСервере()

	СохранитьНаСервере();

	Попытка
		Текст = ОТ_Обмен.ОтправитьСейчас();
	Исключение
		Текст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ОбновитьСостояние();

	Возврат Текст;

КонецФункции

&НаСервере
Процедура ОбновитьСостояние()

	Попытка
		Данные = ОТ_Обмен.Состояние();
		Строки = Новый Массив;
		Строки.Добавить("Чеки отправлены по: " + ?(ЗначениеЗаполнено(Данные.ВыгруженоПо), Формат(Данные.ВыгруженоПо, "ДЛФ=DT"), "ещё нет"));
		Строки.Добавить("Магазины отправлены: " + ?(ЗначениеЗаполнено(Данные.МагазиныОтправлены), Формат(Данные.МагазиныОтправлены, "ДЛФ=DT"), "ещё нет"));
		Строки.Добавить("Последняя ошибка: " + ?(ЗначениеЗаполнено(Данные.ПоследняяОшибка), Данные.ПоследняяОшибка, "нет"));
		Строки.Добавить("Реквизиты чека в этой конфигурации: " + Данные.Схема);
		Состояние = СтрСоединить(Строки, Символы.ПС);
	Исключение
		Состояние = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
