// Тест ядра расширения (общий модуль ОТ_КлиентAPI) в OneScript: тот же код, что в 1С.
// Платформа — ONETRACE_URL и ONETRACE_KEY (секретный ключ): настоящий проект или заглушка tests/mock_server.py.
// Запуск: tests/run.sh (заглушка) или ONETRACE_URL=… ONETRACE_KEY=… tests/run.sh --live.

Перем Ошибок;

Процедура Проверить(Условие, Описание)
	Если Условие Тогда
		Сообщить("  ok   " + Описание);
	Иначе
		Сообщить("  FAIL " + Описание);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция Чек(Ид, Телефон, Карта, Email = "")
	Товары = Новый Массив;
	Товары.Добавить(Новый Структура("Ид, Количество, Цена", "SKU-1", 2, 450.5));
	Возврат Новый Структура("Ид, Дата, Номер, Магазин, Сумма, Телефон, Карта, Email, Товары",
		Ид, Дата(2026, 10, 28, 18, 42, 0), "000123", "msk-1", 901, Телефон, Карта, Email, Товары);
КонецФункции

Ошибок = 0;
ПутьКМодулю = ТекущийСценарий().Каталог + "/../src/CommonModules/ОТ_КлиентAPI/Ext/Module.bsl";
ПодключитьСценарий(ПутьКМодулю, "КлиентAPI");
Клиент = Новый КлиентAPI();

Окружение = ПеременныеСреды();
Настройки = Клиент.НовыеНастройки(Окружение.Получить("ONETRACE_URL"), Окружение.Получить("ONETRACE_KEY"));
Прогон = Окружение.Получить("ONETRACE_RUN");

Сообщить("Сообщение чека");
Сообщение = Клиент.СообщениеЧека(Чек("a1", "+7 916 123-45-67", ""), Настройки);
Проверить(Сообщение.Получить("type") = "track" И Сообщение.Получить("event") = "order_completed", "track order_completed");
Проверить(Сообщение.Получить("messageId") = "1c-a1", "messageId из Ид чека");
Проверить(Сообщение.Получить("properties").Получить("channel") = "offline", "channel = offline");
Проверить(Сообщение.Получить("properties").Получить("store_id") = "msk-1", "store_id");
Проверить(Сообщение.Получить("properties").Получить("amount") = 901, "amount");
Проверить(Сообщение.Получить("properties").Получить("products")[0].Получить("product_id") = "SKU-1", "products");
Проверить(Сообщение.Получить("context").Получить("traits").Получить("phone") = "+7 916 123-45-67", "телефон в context.traits");
Проверить(Сообщение.Получить("context").Получить("traits").Получить("loyalty_card") = Неопределено, "пустая карта не отправляется");
Проверить(СтрЗаканчиваетсяНа(Сообщение.Получить("timestamp"), "Z"), "время в UTC: " + Сообщение.Получить("timestamp"));
Проверить(Не Клиент.ЕстьПокупатель(Чек("a2", "", "")), "чек без покупателя");

Сообщить("Подключение");
Проверка = Клиент.ПроверитьПодключение(Настройки);
Проверить(Проверка.Успех, Проверка.Текст);
Проверить(Не Клиент.ПроверитьПодключение(Клиент.НовыеНастройки(Настройки.Адрес, "wrong-key")).Успех, "неверный ключ — ошибка");

Сообщить("Отправка чеков");
Чеки = Новый Массив;
Чеки.Добавить(Чек("run-" + Прогон + "-1", "+7 916 123-45-67", ""));
Чеки.Добавить(Чек("run-" + Прогон + "-2", "", "7000 1234 5678"));
Чеки.Добавить(Чек("run-" + Прогон + "-3", "", ""));
Чеки.Добавить(Чек("run-" + Прогон + "-4", "не телефон", ""));
Итог = Клиент.ОтправитьЧеки(Настройки, Чеки);
Проверить(Итог.Отправлено = 2, "отправлено 2 чека: " + Итог.Отправлено);
Проверить(Итог.Пропущено.Количество() = 2, "пропущено 2 чека: " + Итог.Пропущено.Количество());
Для Каждого Пропуск Из Итог.Пропущено Цикл
	Сообщить("       пропущен " + Пропуск.Ид + ": " + Пропуск.Причина);
КонецЦикла;

Сообщить("Магазины");
Магазины = Новый Массив;
Магазины.Добавить(Новый Структура("Ид, Наименование, Город, Адрес", "msk-1", "Тверская", "Москва", "Тверская, 1"));
Проверить(Клиент.ОтправитьМагазины(Настройки, Магазины) = 1, "отправлен 1 магазин");

Если Ошибок > 0 Тогда
	Сообщить(СтрШаблон("Ошибок: %1", Ошибок));
	ЗавершитьРаботу(1);
КонецЕсли;

Сообщить("Все проверки прошли");
